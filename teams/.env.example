# Copy to teams/.env and fill in. Never commit the filled copy.

# The HR Genie backend. Same service the Android app and the console use.
HRGENIE_BASE_URL=https://b9e4-103-161-31-154.ngrok-free.app

# --- Proof of concept only -------------------------------------------------
# The bot has no Teams SSO yet, so it needs one account to call the API with.
# Teams SSO replaces both of these: the real app reads the caller's identity from
# their Entra token and never sees a password.
HRGENIE_EMPLOYEE_ID=
HRGENIE_PASSWORD=

# --- Left empty until there is an Azure Bot registration -------------------
# With these unset the adapter accepts unauthenticated calls, which is how the
# Bot Framework Emulator talks to it locally. Teams itself will not work until
# they are filled in.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=

PORT=3978
