# Copy to teams/.env and fill in. Never commit the filled copy.

# The HR Genie backend. Same service the Android app and the console use.
HRGENIE_BASE_URL=https://hrgenie-api.devinfinitylearn.in

# --- The shared account, used only when SSO is off --------------------------
# Everyone who opens the bot is treated as this employee, so the app must stay
# sideloaded to one person while these are what it runs on. Set SSO_CONNECTION_NAME
# below and they stop being used for anything but `npm run try` and the Emulator.
HRGENIE_EMPLOYEE_ID=
HRGENIE_PASSWORD=

# --- Teams SSO --------------------------------------------------------------
# The name of the OAuth connection setting on the Azure Bot (Configuration → Add
# OAuth Connection Settings). Naming it here turns SSO on: each user is then
# identified from their own Entra token and the shared account above is unused.
#
# It also requires POST /api/auth/teams on the backend — see
# docs/TEAMS_SSO_BACKEND.md — and the Entra configuration in docs/IT_REQUEST.md.
SSO_CONNECTION_NAME=

# --- Left empty until there is an Azure Bot registration -------------------
# With these unset the adapter accepts unauthenticated calls, which is how the
# Bot Framework Emulator talks to it locally. Teams itself will not work until
# they are filled in.
#
# SingleTenant, not MultiTenant: HR Genie is for Infinity Learn only. A
# single-tenant bot is bound to one Entra tenant and will not authenticate
# anywhere else, even if the app package leaves the building. MultiTenant is for
# apps meant to be installed by other companies, which this is not.
#
# The tenant is the one behind infinitylearn.com, because that is the identity
# employees sign into Teams with. rankguru.com is a SEPARATE Entra tenant
# (50eba315-1b8e-4f1d-b407-efcdb884200e) — registering the bot there would fail
# to authenticate for every employee. Verify before use:
#   curl https://login.microsoftonline.com/infinitylearn.com/v2.0/.well-known/openid-configuration
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=156a3c5b-d91e-4c1e-a519-1155bc2ff675

# --- Notifications ---------------------------------------------------------
# The shared secret the backend presents on POST /notify. Without it the endpoint
# refuses everything: an open notify endpoint would let anyone on the internet
# push a message that looks like it came from HR into any employee's Teams.
NOTIFY_SECRET=

# Where conversation references are kept between restarts.
REFERENCES_FILE=data/references.json

PORT=3978

# --- Development only -------------------------------------------------------
# The celebrations endpoint returns no work email yet, so the "Wish" button on a
# birthday has nobody to open a chat with and hides itself. Setting this points
# EVERY celebrant at this one mailbox, so the button can be exercised without any
# chance of messaging a colleague. See docs/CELEBRATIONS_BACKEND.md.
WISH_TEST_EMAIL=

# Where the bot is reachable from the internet — the tunnel while developing, a real
# host later. The packager uses it for the "Around the team" tab's contentUrl and adds
# the domain to validDomains. Leave empty to ship without the tab.
PUBLIC_BASE_URL=
