          "commands": [
            {
              "title": "Raise a ticket",
              "description": "File something with HR"
            },
            {
              "title": "My tickets",
              "description": "See what HR has done with them"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "hrgenie-api.devinfinitylearn.in",
