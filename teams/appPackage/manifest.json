    "name": "Infinity Learn",
    "websiteUrl": "https://www.infinitylearn.com",
    "privacyUrl": "https://www.infinitylearn.com/privacy",
    "termsOfUseUrl": "https://www.infinitylearn.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "HR Genie",
    "full": "HR Genie \u2014 Infinity Learn"
