<?xml version="1.0" encoding="utf-8"?>
<!-- Inset gradient strip for the Wishes date line — replaces the flat full-bleed
     header band, which read as a table row rather than a designed element. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_tile" />
    <gradient
        android:angle="0"
        android:endColor="@color/ink_mid"
        android:startColor="@color/ink"
        android:type="linear" />
</shape>
