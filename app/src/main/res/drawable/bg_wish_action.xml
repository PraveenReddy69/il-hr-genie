<?xml version="1.0" encoding="utf-8"?>
<!-- Circular affordance behind the wish emoji, so it reads as a button. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/blue_tint_22">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/blue_tint_07" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/blue_tint_12" />
        </shape>
    </item>
</ripple>
