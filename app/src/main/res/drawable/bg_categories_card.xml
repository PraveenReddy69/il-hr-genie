<?xml version="1.0" encoding="utf-8"?>
<!-- The panel the category tiles sit on. Tinted rather than white so the tiles inside
     read as raised off it — on white they would disappear into the bubble above. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/blue_wash" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/blue_tint_10" />
</shape>
