<?xml version="1.0" encoding="utf-8"?>
<!-- One ticket, standing on its own rather than sharing a list card. The stroke is
     lighter than bg_card because these sit in a stack and the borders would otherwise
     read as a grid. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="@dimen/stroke_hairline" android:color="@color/ink_05" />
    <corners android:radius="18dp" />
</shape>
