<?xml version="1.0" encoding="utf-8"?>
<!-- Something the employee said. Carries a time inside the bubble to match the bot
     side; without it only one half of the transcript is stamped, which reads as a bug. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_user"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="13dp"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.55"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            tools:text="How many leaves do I have left?" />

        <TextView
            android:id="@+id/bubbleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/white_60"
            android:textSize="@dimen/text_eyebrow_sm"
            tools:text="10:42 AM" />
    </LinearLayout>
</FrameLayout>
