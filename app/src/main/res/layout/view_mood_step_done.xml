<?xml version="1.0" encoding="utf-8"?>
<!-- Mood check-in, step 2: confirmation. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/doneScroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/doneContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="34dp"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/doneEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:includeFontPadding="false"
            android:textSize="52sp"
            android:importantForAccessibility="no"
            tools:text="😊" />

        <TextView
            style="@style/HG.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mood_logged" />

        <TextView
            android:id="@+id/thanksLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:lineSpacingMultiplier="1.6"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Love that. Keep a note of what worked this week." />

        <!-- Personal 8-week trend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                android:orientation="horizontal">

                <TextView
                    style="@style/HG.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mood_trend_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_trend_meta"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trendChart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_zone_personal"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Privacy statement (non-negotiable on every sentiment surface) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_card_privacy"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/mood_privacy_title"
                android:textColor="@color/blue_deep"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.65"
                android:text="@string/mood_privacy_body"
                android:textColor="@color/text_slate"
                android:textSize="@dimen/text_caption_lg" />
        </LinearLayout>

        <TextView
            android:id="@+id/backToHome"
            style="@style/HG.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_back_to_home" />
    </LinearLayout>
</ScrollView>
