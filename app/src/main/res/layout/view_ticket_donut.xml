<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket mix: the ring carries the proportion, the legend carries the numbers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp">

        <com.infinitylearn.hrgenie.ui.common.DonutChartView
            android:id="@+id/ticketDonut"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/donutTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/ink"
                android:textSize="26sp"
                tools:text="4" />

            <TextView
                android:id="@+id/donutCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_eyebrow_sm"
                tools:text="tickets" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ticketLegend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
