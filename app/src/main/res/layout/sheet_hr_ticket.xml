<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetScroller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:scrollbars="none">

  <LinearLayout
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_screen"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/space_screen"
    android:paddingBottom="@dimen/space_l">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_grabber"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ticketSheetId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_eyebrow_sm"
            android:textStyle="bold"
            tools:text="HRG-0001" />

        <TextView
            android:id="@+id/ticketSheetCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status"
            android:backgroundTint="@color/blue_tint_10"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/blue_deep"
            android:textSize="@dimen/text_eyebrow_sm"
            android:textStyle="bold"
            tools:text="Payroll" />
    </LinearLayout>

    <TextView
        android:id="@+id/ticketSheetSubject"
        style="@style/HG.H3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.3"
        tools:text="My July payslip is missing from the portal" />

    <TextView
        android:id="@+id/ticketSheetRaisedBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        tools:text="Gunapati Praveen Reddy · Experience · 3h ago" />

    <!-- Outcome first when the ticket is closed: the sheet reports, it does not
         ask. The controls stay behind "Reopen". -->
    <LinearLayout
        android:id="@+id/resolvedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_resolved_banner"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:text="@string/emoji_check"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ticket_closed"
                android:textColor="@color/green_ok"
                android:textSize="@dimen/text_caption_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resolvedMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_eyebrow_sm"
                tools:text="Meera · 2m ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/resolvedNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_slate"
            android:textSize="@dimen/text_caption"
            tools:text="Payslip regenerated and emailed. Portal refreshes overnight." />
    </LinearLayout>

    <TextView
        android:id="@+id/reopenButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_small"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_button_ghost"
        android:gravity="center"
        android:text="@string/ticket_reopen"
        android:textColor="@color/text_slate"
        android:textSize="@dimen/text_body_sm"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

  <LinearLayout
    android:id="@+id/updateSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="4dp"
        android:letterSpacing="0.06"
        android:text="@string/ticket_update_status"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_eyebrow_sm"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/statusOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/commentLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_eyebrow_sm"
        android:textStyle="bold"
        tools:text="What did you do? (required)" />

    <EditText
        android:id="@+id/commentInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="@null"
        android:background="@drawable/bg_comment_field"
        android:gravity="top|start"
        android:hint="@string/ticket_comment_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingMultiplier="1.35"
        android:minHeight="82dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_body_sm" />

    <TextView
        android:id="@+id/commentError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="6dp"
        android:text="@string/ticket_comment_required"
        android:textColor="@color/red_risk"
        android:textSize="@dimen/text_eyebrow"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/applyUpdate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_small"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_button_gradient_blue"
        android:gravity="center"
        android:text="@string/ticket_apply_update"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body_sm"
        android:textStyle="bold" />
  </LinearLayout>

    <!-- What HR has already recorded on this ticket. -->
    <LinearLayout
        android:id="@+id/commentHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/ticketSheetNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:text="@string/ticket_update_note"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_eyebrow_sm" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
