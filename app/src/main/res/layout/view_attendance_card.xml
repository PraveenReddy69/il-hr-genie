<?xml version="1.0" encoding="utf-8"?>
<!-- Check in / check out, with the 8-hour clock. Leads the Home column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_attendance_card"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_screen"
    android:paddingTop="@dimen/space_screen"
    android:paddingEnd="@dimen/space_screen"
    android:paddingBottom="@dimen/space_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/HG.H3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/attendance_title" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_muted"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="11dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/attendanceStatusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_muted"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/attendanceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_eyebrow"
                tools:text="Checked in" />
        </LinearLayout>
    </LinearLayout>

    <!-- One panel, two faces: the invitation before check-in, the clock after. -->
    <LinearLayout
        android:id="@+id/attendanceWell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_timer_well"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <LinearLayout
            android:id="@+id/attendanceIdleBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_tile_clock"
                android:padding="11dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/blue_deep"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.015"
                    android:text="@string/attendance_idle_title"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_title_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/attendanceIdleProjection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption_lg"
                    tools:text="Check in now and you're done by 5:42 PM." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attendanceRunningBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            tools:visibility="gone">

            <TextView
                android:id="@+id/attendanceTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:textColor="@color/ink"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="06:42:18" />

            <TextView
                android:id="@+id/attendanceTimerCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption_lg"
                tools:text="left of your 8-hour day" />

            <FrameLayout
                android:id="@+id/attendanceTrack"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_progress_track">

                <View
                    android:id="@+id/attendanceTrackFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress_fill_blue" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/attendanceInAt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_micro"
                    tools:text="In 9:32 AM" />

                <TextView
                    android:id="@+id/attendanceTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_micro"
                    tools:text="8h at 5:32 PM" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/attendanceAction"
        style="@style/HG.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_button_gradient_blue"
        android:elevation="6dp"
        android:letterSpacing="0.015"
        android:textSize="@dimen/text_title_lg"
        tools:text="Check in" />

    <!-- Quiet footnote rather than a paragraph competing with the action. -->
    <LinearLayout
        android:id="@+id/attendanceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emoji_lock"
            android:textSize="11sp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.45"
            android:text="@string/attendance_note"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_micro" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_screen"
        android:background="@color/ink_06" />

    <LinearLayout
        android:id="@+id/attendanceWeekLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/HG.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/attendance_week_title" />

            <TextView
                android:id="@+id/attendanceWeekTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption_lg"
                tools:text="18h 20m of 40h · 3 days present" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:text="@string/attendance_week_link"
            android:textColor="@color/blue_deep"
            android:textSize="@dimen/text_caption_lg"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/blue_deep"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Single-line wrap-up once the day is closed. -->
    <LinearLayout
        android:id="@+id/attendanceSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/bg_card_privacy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/attendanceSummaryIcon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_check"
            app:tint="@color/green_ok"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/attendanceSummaryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_slate"
            android:textSize="@dimen/text_caption_lg"
            app:autoSizeMaxTextSize="12.5sp"
            app:autoSizeMinTextSize="9.5sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            tools:text="Checked out 6:42 PM · 8h 12m worked · 12m overtime" />
    </LinearLayout>
</LinearLayout>
