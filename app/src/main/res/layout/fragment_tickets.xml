<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================================ Header ================================ -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_home">

            <View
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-120dp"
                android:layout_marginEnd="-90dp"
                android:background="@drawable/bg_header_glow"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_screen"
                android:paddingTop="@dimen/space_l"
                android:paddingEnd="@dimen/space_screen"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/backButton"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_back"
                        android:src="@drawable/ic_back"
                        app:tint="@color/white_85" />

                    <TextView
                        style="@style/HG.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:letterSpacing="0.073"
                        android:text="@string/hrbp_view"
                        android:textColor="@color/white_50" />
                </LinearLayout>

                <TextView
                    style="@style/HG.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tickets_screen_title"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/ticketsSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white_55"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="5 raised · 2 still open" />
            </LinearLayout>
        </FrameLayout>

        <!-- ================================= Body ================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen"
            android:paddingTop="@dimen/space_screen"
            android:paddingEnd="@dimen/space_screen"
            android:paddingBottom="@dimen/space_xl">

            <!-- ======== Status mix ======== -->
            <LinearLayout
                android:id="@+id/mixCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_screen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/orange_tint_14"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/emoji_ticket"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/HG.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:text="@string/tickets_mix_title" />
                </LinearLayout>

                <include
                    android:id="@+id/ticketSummary"
                    layout="@layout/view_ticket_donut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ======== Queue ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_screen">

                <!-- The ring above always shows the whole picture, so filtering here
                     never hides the totals. -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ticketFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/ticketList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/ticketFilterEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_xl"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:text="Nothing in progress right now."
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:text="@string/tickets_screen_note"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_eyebrow" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
