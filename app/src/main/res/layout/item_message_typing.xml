<?xml version="1.0" encoding="utf-8"?>
<!-- The dots rise and scale as they animate, which takes them outside the box they
     were measured in. Every container between them and the row therefore has to stop
     clipping, or the top of each dot is shaved off at the peak of its bounce. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_bot"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="15dp"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="15dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_blue" />

        <View
            android:id="@+id/dot2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_dot_blue" />

        <View
            android:id="@+id/dot3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_dot_blue" />
    </LinearLayout>
</FrameLayout>
