<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================================ Header ================================ -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_home">

            <View
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-120dp"
                android:layout_marginEnd="-90dp"
                android:background="@drawable/bg_header_glow"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_screen"
                android:paddingTop="@dimen/space_l"
                android:paddingEnd="@dimen/space_screen"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/backButton"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_back"
                        android:src="@drawable/ic_back"
                        app:tint="@color/white_85" />

                    <TextView
                        style="@style/HG.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:letterSpacing="0.073"
                        android:text="@string/hrbp_view"
                        android:textColor="@color/white_50" />
                </LinearLayout>

                <TextView
                    style="@style/HG.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trends_title"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/trendsSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white_55"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="14 days · 6 pulse cycles" />
            </LinearLayout>
        </FrameLayout>

        <!-- ================================= Body ================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen"
            android:paddingTop="@dimen/space_screen"
            android:paddingEnd="@dimen/space_screen"
            android:paddingBottom="@dimen/space_xl">

            <!-- ======== Mood, day by day ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_screen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/purple_tint_12"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/emoji_pulse"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HG.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/trends_mood_title" />

                        <TextView
                            android:id="@+id/moodTrendSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            tools:text="Averaging 6.8 over 5 days with answers" />
                    </LinearLayout>

                    <TextView
                        style="@style/HG.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hr_tap_hint"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/moodTrendChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/moodTrendEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_l"
                    android:paddingBottom="@dimen/space_l"
                    android:text="@string/trends_mood_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ======== Pulse by cycle ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_screen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/blue_tint_10"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/emoji_chart"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/HG.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:text="@string/trends_pulse_title" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pulseCycleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ======== How the selected cycle answered ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_screen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/green_tint_14"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/emoji_bulb"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HG.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/trends_answers_title" />

                        <TextView
                            android:id="@+id/answersSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            tools:text="August · 2 of 4 answered" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/answerBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/answersEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_xl"
                    android:text="@string/trends_answers_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Debug builds only: fills the screens above with a fortnight of data
                 so a demo has something to show. -->
            <LinearLayout
                android:id="@+id/seederCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_empty_state"
                android:orientation="vertical"
                android:padding="@dimen/space_screen"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/seed_title"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_eyebrow_sm"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/seed_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/seedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button_small"
                        android:layout_weight="1.4"
                        android:background="@drawable/bg_button_gradient_blue"
                        android:gravity="center"
                        android:text="@string/seed_action"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/clearSeedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button_small"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_ghost"
                        android:gravity="center"
                        android:text="@string/seed_clear"
                        android:textColor="@color/text_slate"
                        android:textSize="@dimen/text_body_sm"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:text="@string/insights_legal"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_eyebrow" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
