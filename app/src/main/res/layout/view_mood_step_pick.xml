<?xml version="1.0" encoding="utf-8"?>
<!-- Mood check-in, step 0: choose a face. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pickScroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/pickContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="26dp"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="40dp">

        <TextView
            style="@style/HG.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.029"
            android:lineSpacingMultiplier="1.18"
            android:text="@string/mood_step0_title"
            android:textSize="@dimen/text_h1_lg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.6"
            android:text="@string/mood_step0_sub"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/moodRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
