<?xml version="1.0" encoding="utf-8"?>
<!-- Slides up from the bottom of Sign in when an employee ID isn't in the directory. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:elevation="24dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_sheet_grabber"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_tile_alert"
        android:padding="15dp"
        android:src="@drawable/ic_alert"
        app:tint="@color/red_risk"
        android:importantForAccessibility="no" />

    <TextView
        style="@style/HG.H2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/hr_help_title"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/hrHelpId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_id"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:paddingStart="13dp"
        android:paddingTop="7dp"
        android:paddingEnd="13dp"
        android:paddingBottom="7dp"
        android:textColor="@color/ink"
        android:textSize="12.5sp"
        android:textStyle="bold"
        tools:text="EMP3804" />

    <TextView
        android:id="@+id/hrHelpBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.55"
        android:text="@string/hr_help_body"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <!-- Tappable contact row: the address is visible, not just behind a button. -->
    <LinearLayout
        android:id="@+id/hrHelpContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_contact_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile_mail"
            android:padding="10dp"
            android:src="@drawable/ic_mail"
            app:tint="@color/blue_deep"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/HG.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hr_help_contact_label"
                android:textSize="@dimen/text_eyebrow_sm" />

            <TextView
                android:id="@+id/hrHelpEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/blue_deep"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="hr@infinitylearn.com" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.55"
        android:text="@string/hr_help_detail"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption_lg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hrHelpDismiss"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/action_try_again"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/hrHelpEmail"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_button_gradient_blue"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/action_email_hr"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
