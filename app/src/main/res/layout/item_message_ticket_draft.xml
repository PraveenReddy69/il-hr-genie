<?xml version="1.0" encoding="utf-8"?>
<!-- The ticket about to be raised. Nothing is written until "Raise it" is tapped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="46dp"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_icon_chip"
                android:backgroundTint="@color/orange_tint_14"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/emoji_ticket"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="@string/ticket_draft_title"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_eyebrow_sm"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/draftCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_status"
            android:backgroundTint="@color/blue_tint_10"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/blue_deep"
            android:textSize="@dimen/text_eyebrow_sm"
            android:textStyle="bold"
            tools:text="Payroll" />

        <TextView
            android:id="@+id/draftSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="My July payslip is missing from the portal." />

        <TextView
            android:id="@+id/draftRaisedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_eyebrow"
            tools:text="Raised by Gunapati Praveen Reddy · EMP3801" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancelTicket"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button_small"
                android:layout_weight="1"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center"
                android:text="@string/action_cancel"
                android:textColor="@color/text_slate"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/raiseTicket"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button_small"
                android:layout_marginStart="10dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_button_gradient_blue"
                android:gravity="center"
                android:text="@string/action_raise_ticket"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
