<?xml version="1.0" encoding="utf-8"?>
<!-- One pulse cycle: month, completion bar, and how many answered. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cycleRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cycleMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body_sm"
            tools:text="August 2026" />

        <TextView
            android:id="@+id/cycleCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:background="@drawable/bg_pill_status"
            android:backgroundTint="@color/blue_tint_10"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/trends_current_cycle"
            android:textColor="@color/blue_deep"
            android:textSize="@dimen/text_eyebrow_sm"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/cycleCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_slate"
            android:textSize="@dimen/text_caption_lg"
            android:textStyle="bold"
            tools:text="2 / 4" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cycleTrack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/track_height"
        android:background="@drawable/bg_track">

        <View
            android:id="@+id/cycleTrackFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_track_fill_blue" />
    </FrameLayout>
</LinearLayout>
