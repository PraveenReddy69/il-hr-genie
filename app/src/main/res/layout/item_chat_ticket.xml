<?xml version="1.0" encoding="utf-8"?>
<!-- One of the employee's own tickets, as a tile inside a chat card.
     The category glyph replaces the old accent bar: a 3dp stripe carried the status
     colour but said nothing about what the ticket was, and the status is already
     spelled out in words on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_tile"
    android:elevation="1.5dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="11dp"
    android:paddingEnd="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/chatTicketGlyph"
        android:layout_gravity="top"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_category_glyph"
        android:contentDescription="@null"
        android:padding="6dp"
        tools:src="@drawable/ic_cat_payroll" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The status shares the subject's line. A subject can wrap gracefully; the
             meta line beneath cannot, because breaking "22m ago" across two rows for
             the sake of a pill looks like a bug. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatTicketSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:textColor="@color/ink_deep"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                tools:text="My July payslip is missing from the portal." />

            <TextView
                android:id="@+id/chatTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_status"
                android:includeFontPadding="false"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="5dp"
                android:textSize="@dimen/text_eyebrow_sm"
                android:textStyle="bold"
                tools:text="Open" />
        </LinearLayout>

        <!-- Never truncated: the id is what an employee quotes to HR. -->
        <TextView
            android:id="@+id/chatTicketMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_eyebrow"
            tools:text="HRG-0001 · Payroll · just now" />
    </LinearLayout>
</LinearLayout>
