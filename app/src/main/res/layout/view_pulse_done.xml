<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when this month's pulse has already been answered. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/doneScroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/pulseDoneContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_tile_celebrate"
            android:padding="18dp"
            android:src="@drawable/ic_seal_check"
            app:tint="@color/cyan"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/pulseDoneTitle"
            style="@style/HG.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="-0.03"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/white"
            android:textSize="30sp"
            tools:text="August pulse — all done" />

        <TextView
            android:id="@+id/pulseDoneGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.65"
            android:textColor="@color/white_62"
            android:textSize="14.5sp"
            tools:text="Thanks, Aamy. You answered on 7 August — nothing more to do this month." />

        <!-- Their own answers, on their own device. HR only ever sees the themes. -->
        <LinearLayout
            android:id="@+id/pulseAnswersCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <TextView
                style="@style/HG.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:letterSpacing="0.082"
                android:text="@string/pulse_done_answers_title"
                android:textColor="@color/white_50" />

            <LinearLayout
                android:id="@+id/pulseAnswerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <TextView
                style="@style/HG.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:letterSpacing="0.082"
                android:text="@string/pulse_changed_eyebrow"
                android:textColor="@color/white_50" />

            <LinearLayout
                android:id="@+id/pulseDoneOutcomes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/pulseDoneButton"
            style="@style/HG.Button.White"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_input"
            android:layout_marginTop="24dp"
            android:text="@string/action_back_to_home" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/pulse_done_privacy"
            android:textColor="@color/white_45"
            android:textSize="@dimen/text_micro" />
    </LinearLayout>
</ScrollView>
